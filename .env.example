# Required: dedicated Scheduler PostgreSQL database with database/schema.sql applied.
SCHEDULER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/kokoro_scheduler

# Required for the internal control API. Empty means command routes fail closed.
SCHEDULER_INTERNAL_SERVICE_TOKEN=TOKEN

# Optional independent credential for Scheduler -> target dispatch.
SCHEDULER_TARGET_SERVICE_TOKEN=

# Optional coordination only; Scheduler must use logical DB 7.
# SCHEDULER_REDIS_URL=redis://HOST:PORT/7

# Optional exact internal hostname/CIDR policy.
# SCHEDULER_INTERNAL_TARGET_ALLOWLIST='[{"host":"service.internal","cidrs":["10.0.0.7/32"]}]'

# SCHEDULER_HTTP_ADDR=:8080
# SCHEDULER_WAKEUP_INTERVAL=1s
# SCHEDULER_CLAIM_TTL=2m
# SCHEDULER_DISPATCH_TIMEOUT=30s
# SCHEDULER_BATCH_SIZE=100
# SCHEDULER_WORKER_ID=scheduler-a
