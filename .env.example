# kokoro-scheduler local configuration. Keep secrets out of this file.
# An empty array starts the scheduler with no business dispatches.
SCHEDULER_JOBS_JSON='[]'

# Required to use the BFF -> Scheduler internal job command surface.
SCHEDULER_INTERNAL_SERVICE_TOKEN=TOKEN

# HTTP server bind address. Health/readiness and internal command routes share this listener.
# SCHEDULER_HTTP_ADDR=:8080

# Optional for multi-instance occurrence leases. A single instance can run
# without Redis; when set, all scheduler instances must share this Redis URL.
# SCHEDULER_REDIS_URL=redis://HOST:6379/15

# Integration tests only; do not use this value as a production credential.
# SCHEDULER_REDIS_TEST_URL=redis://HOST:6379/15
